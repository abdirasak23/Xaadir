# Copy to .env.local for local development. Replace every placeholder locally.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

EDGE_FUNCTION_SECRET=replace-with-edge-function-secret
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
